# ── Owner console (required in production) ────────────────────────────
# Passcode for /admin. Checked on the server only — never exposed to browsers.
ADMIN_PASSCODE=change-me-to-a-long-random-passcode
# Secret used to sign the owner session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── Public site ───────────────────────────────────────────────────────
# Absolute URL of the deployed site (used for social previews / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://your-store.example
NEXT_PUBLIC_STORE_NAME="Apna Kirana Store"

# Load sample orders/customers/tickets for demos. Leave unset in production.
# NEXT_PUBLIC_DEMO_DATA=true

# ── Supabase (schema in supabase/migrations — not wired to the UI yet) ──
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
